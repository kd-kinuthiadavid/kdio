# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres (Drizzle)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Resend (transactional email)
RESEND_API_KEY=
# Must be a verified sender in Resend (e.g. onboarding@resend.dev in dev)
RESEND_FROM_EMAIL=onboarding@resend.dev
# Where owner notifications go
NOTIFY_EMAIL=you@example.com

# Resume links in email + API auth (min 16 chars)
RESUME_JWT_SECRET=

# Vercel Cron (Authorization: Bearer …). On Vercel Hobby, crons run at most once per day — see vercel.json schedule.
CRON_SECRET=
# Automatic invoice reminders send only when "true"; otherwise the daily run is a dry run
INVOICE_REMINDERS_ENABLED=false

# Upstash Redis via Vercel Marketplace (optional — rate limits disabled if unset)
# Populated by `vercel env pull`; UPSTASH_REDIS_REST_URL/TOKEN are also accepted.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Issuer details printed on invoices, credit notes and debit notes.
# Multi-line values use a literal \n between lines.
ISSUER_NAME=David Kinuthia
ISSUER_EMAIL=
ISSUER_PHONE=
ISSUER_WEBSITE=
ISSUER_ADDRESS=Nairobi\nKenya
ISSUER_KRA_PIN=
# Leave empty if not VAT-registered
ISSUER_VAT_NUMBER=
ISSUER_PAYMENT_DETAILS=Bank: …\nAccount name: …\nAccount no: …\nSWIFT: …\nM-Pesa paybill: …

# Cal.com (optional overrides)
NEXT_PUBLIC_CAL_STRATEGY_URL=https://cal.com/kinuthiadavid/15min
NEXT_PUBLIC_CAL_DISCOVERY_URL=https://cal.com/kinuthiadavid/15min
NEXT_PUBLIC_NURTURE_GUIDE_URL=https://cal.com/kinuthiadavid/15min
